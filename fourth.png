<script>
  // Simple micro-interactions for the view switcher
  document.addEventListener('DOMContentLoaded', () => {
    const btnKanban = document.getElementById('view-kanban');
    const btnTable = document.getElementById('view-table');
    const btnCalendar = document.getElementById('view-calendar');

    const setActive = (activeBtn) => {
      [btnKanban, btnTable, btnCalendar].forEach(btn => {
        btn.classList.remove('bg-surface-container-high', 'text-primary');
        btn.classList.add('text-on-surface-variant');
      });
      activeBtn.classList.remove('text-on-surface-variant');
      activeBtn.classList.add('bg-surface-container-high', 'text-primary');
    };

    if (btnKanban && btnTable && btnCalendar) {
      btnKanban.addEventListener('click', () => setActive(btnKanban));
      btnTable.addEventListener('click', () => {
        setActive(btnTable);
        alert('Switching to tabular spreadsheet view...');
      });
      btnCalendar.addEventListener('click', () => {
        setActive(btnCalendar);
        alert('Switching to Gantt & interview deadlines view...');
      });
    }
  });
</script></main><footer class="w-full bg-surface-container-lowest border-t border-outline-variant/20 py-space-lg mt-auto"><div class="w-full px-gutter flex flex-col md:flex-row items-center justify-between gap-space-md"><div class="flex items-center gap-space-sm"><span class="font-code-sm text-code-sm text-on-surface-variant">© 2025 InternTrack Telemetry Engine</span><span class="text-outline-variant">•</span><span class="font-code-sm text-code-sm text-tertiary">v2.8.4-prod</span></div><div class="flex items-center gap-space-md font-code-sm text-code-sm text-on-surface-variant"><span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-tertiary"></span>Pipeline Latency: 14ms</span><span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-secondary"></span>FAANG Scraping: Online</span></div></div></footer></body></html>
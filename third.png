</div>
<script>
    function copyIndividualBullet(bulletId, btnElement) {
      const text = document.getElementById(bulletId).innerText;
      navigator.clipboard.writeText(text).then(() => {
        const icon = btnElement.querySelector('.material-symbols-outlined');
        const origIcon = icon.innerText;
        icon.innerText = 'check';
        icon.classList.add('text-tertiary');
        setTimeout(() => {
          icon.innerText = origIcon;
          icon.classList.remove('text-tertiary');
        }, 1500);
      });
    }

    function copyAllBullets() {
      const b1 = document.getElementById('bullet-1').innerText;
      const b2 = document.getElementById('bullet-2').innerText;
      const b3 = document.getElementById('bullet-3').innerText;
      const fullText = `• ${b1}\n• ${b2}\n• ${b3}`;

      navigator.clipboard.writeText(fullText).then(() => {
        const btnText = document.getElementById('copy-all-text');
        const btnIcon = document.getElementById('copy-all-icon');
        const origText = btnText.innerText;
        btnText.innerText = 'Copied All to Clipboard!';
        btnIcon.innerText = 'check_circle';
        btnIcon.classList.add('text-tertiary');
        setTimeout(() => {
          btnText.innerText = origText;
          btnIcon.innerText = 'content_copy';
          btnIcon.classList.remove('text-tertiary');
        }, 2000);
      });
    }
  </script>

<html class="dark" lang="en"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><meta content="web_standard" name="shell-type"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500;600&amp;family=Plus+Jakarta+Sans:wght@600;700&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = {darkMode: "class", theme: {extend: {colors: {"on-tertiary-container": "#000703", "surface-container": "#171f33", "inverse-surface": "#dae2fd", "tertiary-fixed": "#6ffbbe", secondary: "#4cd7f6", "on-surface-variant": "#c7c4d7", "secondary-fixed-dim": "#4cd7f6", "on-tertiary": "#003824", "surface-container-low": "#131b2e", "tertiary-fixed-dim": "#4edea3", "surface-tint": "#c0c1ff", "error-container": "#93000a", error: "#ffb4ab", "surface-variant": "#2d3449", "on-secondary-fixed-variant": "#004e5c", "surface-container-highest": "#2d3449", "on-tertiary-fixed-variant": "#005236", "on-secondary-fixed": "#001f26", "on-background": "#dae2fd", "surface-dim": "#0b1326", "outline-variant": "#464554", "on-primary-container": "#0d0096", primary: "#c0c1ff", background: "#0b1326", "tertiary-container": "#00885d", surface: "#0b1326", "primary-fixed": "#e1e0ff", "inverse-on-surface": "#283044", "on-secondary-container": "#00424e", "on-surface": "#dae2fd", "secondary-fixed": "#acedff", "on-tertiary-fixed": "#002113", "primary-fixed-dim": "#c0c1ff", "on-error": "#690005", "on-primary-fixed": "#07006c", "surface-container-high": "#222a3d", "surface-container-lowest": "#060e20", "on-error-container": "#ffdad6", "on-secondary": "#003640", "primary-container": "#8083ff", "inverse-primary": "#494bd6", tertiary: "#4edea3", "on-primary": "#1000a9", "surface-bright": "#31394d", outline: "#908fa0", "on-primary-fixed-variant": "#2f2ebe", "secondary-container": "#03b5d3"}, borderRadius: {DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem"}, spacing: {gutter: "1rem", "space-xs": "0.25rem", "space-xl": "2rem", "space-sm": "0.5rem", margin: "1.5rem", "space-lg": "1.25rem", "space-md": "0.75rem"}, fontFamily: {"headline-sm": ["Plus Jakarta Sans"], "label-caps": ["JetBrains Mono"], "body-md": ["Inter"], "body-lg": ["Inter"], "headline-md": ["Plus Jakarta Sans"], "code-lg": ["JetBrains Mono"], "code-sm": ["JetBrains Mono"], "code-md": ["JetBrains Mono"], "body-sm": ["Inter"], "headline-lg": ["Plus Jakarta Sans"], "display-lg": ["Plus Jakarta Sans"], headline: ["Plus Jakarta Sans"], display: ["Plus Jakarta Sans"], body: ["Inter"], label: ["JetBrains Mono"]}, fontSize: {"headline-sm": ["18px", {lineHeight: "26px", letterSpacing: "-0.01em", fontWeight: "600"}], "label-caps": ["10px", {lineHeight: "12px", letterSpacing: "0.08em", fontWeight: "600"}], "body-md": ["14px", {lineHeight: "20px", letterSpacing: "0em", fontWeight: "400"}], "body-lg": ["16px", {lineHeight: "24px", letterSpacing: "-0.01em", fontWeight: "400"}], "headline-md": ["22px", {lineHeight: "30px", letterSpacing: "-0.015em", fontWeight: "600"}], "code-lg": ["14px", {lineHeight: "20px", letterSpacing: "-0.01em", fontWeight: "500"}], "code-sm": ["11px", {lineHeight: "14px", letterSpacing: "0.02em", fontWeight: "400"}], "code-md": ["12px", {lineHeight: "16px", letterSpacing: "0em", fontWeight: "500"}], "body-sm": ["12px", {lineHeight: "18px", letterSpacing: "0.01em", fontWeight: "400"}], "headline-lg": ["30px", {lineHeight: "38px", letterSpacing: "-0.02em", fontWeight: "700"}], "display-lg": ["40px", {lineHeight: "48px", letterSpacing: "-0.03em", fontWeight: "700"}]}}}};</script></head><body class="bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col"><header class="fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.35)]"><div class="h-16 w-full px-gutter flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-md flex-shrink-0"><div class="flex items-center gap-space-sm"><img alt="InternTrack Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1UgqWSBiplGO6KWzuopYcvUkLLJrQ3v5_-BpB_Nr3Pvq4V3bw8vbavoXTw6jRp_dOPnJxIMTZM8jBmzeFP5VfJJNNtVC1bD972I83CVpYKuvhq0EtGhHoxvIPufNv3AUf_yaBidEQNjh8TMIE5VCG-Mhuw5_LeiU5P9rM9hITjeToxXl4hIzZCG61Va1EOmsB4pD4utqmfQfDR11WU6LQq6tf8C8njjWBSF2TU-w9eOej7hk9L-lW2abYLp"/><span class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">InternTrack</span></div><div class="hidden sm:inline-flex items-center px-space-sm py-space-xs rounded-full bg-surface-container-high border border-outline-variant/40"><span class="font-code-sm text-code-sm text-tertiary font-medium">FAANG 2025</span></div></div><nav class="hidden xl:flex items-center gap-space-xs" data-active-classes="bg-primary-container text-on-primary font-semibold rounded-lg shadow-[0_0_12px_rgba(128,131,255,0.3)]"><a aria-current="page" class="px-space-md py-space-sm transition-colors bg-primary-container text-on-primary font-semibold rounded-lg shadow-[0_0_12px_rgba(128,131,255,0.3)]" data-path="deadlines-hub" href="#">Deadlines Hub</a><a class="px-space-md py-space-sm rounded-lg font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="company-guides" href="#">Company Guides</a><a class="px-space-md py-space-sm rounded-lg font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="standout-projects" href="#">Standout Projects</a><a class="px-space-md py-space-sm rounded-lg font-body-md text-body-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="my-applications" href="#">My Applications</a></nav><div class="flex items-center gap-space-sm flex-1 max-w-xl justify-end"><div class="relative w-full max-w-xs hidden md:block"><span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-
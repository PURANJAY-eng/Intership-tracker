<!-- 3. MAIN SPLIT WORKSPACE: DATA TABLE + FORECAST INSPECTOR -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-space-lg items-start">
<!-- LEFT: HIGH-DENSITY INTERNSHIP DATA TABLE (Spans 8 columns on 2xl) -->
<div class="xl:col-span-8 bg-surface-container-low rounded-xl shadow-xl overflow-hidden flex flex-col">
<!-- Table Sub-Header Controls -->
<div class="px-space-md py-space-sm bg-surface-container flex items-center justify-between border-b-0">
<div class="flex items-center gap-space-sm">
<span class="font-headline-sm text-headline-sm text-on-surface font-semibold">Priority Cycle Openings</span>
<span class="px-2 py-0.5 rounded bg-surface-container-highest text-tertiary font-code-sm text-code-sm font-semibold">Wave 01 Active</span>
</div>
<div class="flex items-center gap-space-xs text-on-surface-variant font-code-sm text-code-sm">
<span>Showing 6 of 142</span>
<button class="p-1 hover:text-on-surface"><span class="material-symbols-outlined text-base">refresh</span></button>
</div>

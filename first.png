mt-1">CS @ Berkeley</span></div><img alt="Profile" class="w-8 h-8 rounded-full object-cover ring-1 ring-primary-container/40" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA3xcZQ_oh54vYggICgfPWIF5X_k7rWXJUIeqolj-Ingd20UgjXTOLoDmGKT0OlTRZuBaS_8beMVJUcJ4ya8XulzsH_5e-kAcpSpkSjSAvKIyt7njxLj2s1HJlcq9OXsOrtGNj7v_XyHYWol_7HjPEeGlcAcQpcBA-DCKqbGy8iM__l-yxZ7cviPZ66LwTrJF4IR3vrQYgNnr5vvu23F6xsPpl3-s_qoN6xxPzmMBHk4tsUcyCkPTgaiw"/></div></div></div></header><main class="w-full pt-16 bg-surface flex-1"><div class="flex flex-col w-full">
<!-- Subtle Ambient Glow Orbs (Contained) -->
<div class="relative w-full overflow-hidden">
<div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute top-20 right-10 w-80 h-80 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
<!-- MAIN CONTAINER -->
<div class="w-full px-gutter py-space-lg flex flex-col gap-space-lg">
<!-- SUB-NAV / CONTEXT STRIP -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-space-sm pb-space-xs">
<div class="flex items-center gap-space-sm flex-wrap">
<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-tertiary font-code-sm text-code-sm">
<span class="w-1.5 h-1.5 rounded-full bg-tertiary shadow-[0_0_8px_#4edea3]"></span>
            REAL-TIME PIPELINE MONITOR
          </span>
<span class="text-outline-variant font-code-sm text-code-sm">•</span>
<span class="font-code-sm text-code-sm text-on-surface-variant">Last automated cycle scrape: <span class="text-on-surface font-medium">3 mins ago (US-West node)</span></span>
</div>
<div class="flex items-center gap-space-sm">
<button class="inline-flex items-center gap-1.5 px-space-md py-1.5 rounded bg-surface-container-high hover:bg-surface-variant text-on-surface font-code-sm text-code-sm transition-all shadow-sm" type="button">
<span class="material-symbols-outlined text-sm text-secondary">tune</span>
<span>Pipeline Config</span>
</button>
<button class="inline-flex items-center gap-1.5 px-space-md py-1.5 rounded bg-primary-container text-on-primary font-headline-sm text-code-sm font-semibold shadow-[0_0_14px_rgba(128,131,255,0.35)] hover:brightness-110 transition-all" type="button">
<span class="material-symbols-outlined text-base">download_for_offline</span>
<span>Export CSV</span>
</button>
</div>
</div>
<!-- 1. KPI METRIC STRIP (4-Part Terminal Tiles) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- Tile 1 -->
<div class="bg-surface-container-low hover:bg-surface-container transition-all p-space-md rounded-xl shadow-md flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 left-0 w-1 h-full bg-primary-container"></div>
<div class="flex items-start justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Active Tracked</span>
<span class="material-symbols-outlined text-primary text-xl">database</span>
</div>
<div class="mt-space-sm flex items-baseline gap-space-sm">
<span class="font-headline-lg text-headline-lg text-on-surface tracking-tight">142</span>
<span class="font-code-sm text-code-sm text-tertiary flex items-center font-medium">+12 this wk</span>
</div>
<div class="mt-2 flex items-center justify-between text-on-surface-variant font-code-sm text-code-sm">
<span>Verified 2025 listings</span>
<span class="text-primary font-medium">98.4% live</span>
</div>
</div>
<!-- Tile 2 -->
<div class="bg-surface-container-low hover:bg-surface-container transition-all p-space-md rounded-xl shadow-md flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 left-0 w-1 h-full bg-error"></div>
<div class="flex items-start justify-between">
<span class="font-label-caps text-label-caps text-error uppercase tracking-wider">Closing &lt; 7 Days</span>
<span class="material-symbols-outlined text-error text-xl animate-pulse">timer</span>
</div>
<div class="mt-space-sm flex items-baseline gap-space-sm">
<span class="font-headline-lg text-headline-lg text-on-surface tracking-tight">19</span>
<span class="font-code-sm text-code-sm text-error flex items-center font-semibold">Priority Action</span>
</div>
<div class="mt-2 flex items-center justify-between text-on-surface-variant font-code-sm text-code-sm">
<span>Netflix, Databricks, Jane St</span>
<span class="text-error font-medium">Cap risk</span>
</div>
</div>
<!-- Tile 3 -->
<div class="bg-surface-container-low hover:bg-surface-container transition-all p-space-md rounded-xl shadow-md flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 left-0 w-1 h-full bg-tertiary"></div>
<div class="flex items-start justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">FAANG Open Today</span>
<span class="material-symbols-outlined text-tertiary text-xl">rocket_launch</span>
</div>
<div class="mt-space-sm flex items-baseline gap-space-sm">
<span class="font-headline-lg text-headline-lg text-on-surface tracking-tight">8</span>
<span class="font-code-sm text-code-sm text-tertiary flex items-center font-medium">+2 newly unlocked</span>
</div>
<div class="mt-2 flex items-center justify-between text-on-surface-variant font-code-sm text-code-sm">
<span>Google, Meta, Apple live</span>
<span class="text-tertiary font-medium">Wave 01</span>
</div>
</div>
<!-- Tile 4 -->
<div class="bg-surface-container-low hover:bg-surface-container transition-all p-space-md rounded-xl shadow-md flex flex-col justify-between relative overflow-hidden group">
<div class="absolute top-0 left-0 w-1 h-full bg-secondary"></div>
<div class="flex items-start justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Peak Window</span>
<span class="material-symbols-outlined text-secondary text-xl">analytics</span>
</div>
<div class="mt-space-sm flex items-baseline gap-space-sm">
<span class="font-headline-md text-headline-md text-on-surface tracking-tight">Aug – Oct</span>
<span class="font-code-sm text-code-sm text-secondary flex items-center">74% of quota</span>
</div>
<div class="mt-2 flex items-center justify-between text-on-surface-variant font-code-sm text-code-sm">
<span>Rolling cadence window</span>
<span class="text-secondary font-medium">Days left: 68</span>
</div>
</div>
</div>
<!-- 2. RICH SEARCH & INTERACTIVE FILTER TOOLBAR -->
<div class="bg-surface-container-low p-space-md rounded-xl shadow-lg flex flex-col gap-space-md">
<!-- Top Row: Global Search Input + Quick Filters -->
<div class="flex flex-col lg:flex-row gap-space-sm items-stretch lg:items-center justify-between">
<div class="relative flex-1">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">search</span>
<input class="w-full pl-10 pr-space-md py-2.5 bg-surface-container-lowest text-on-surface placeholder:text-outline font-code-sm text-code-sm rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-container shadow-inner" id="role-search" placeholder="Filter by company, role keyword, tech stack (e.g. Go, PyTorch, C++, Distributed)..." type="text"/>
<span class="hidden sm:inline-block absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface-variant font-code-sm text-code-sm">⌘K</span>
</div>
<div class="flex items-center gap-space-xs flex-wrap sm:flex-nowrap">
<!-- Role Category Dropdown -->
<div class="relative inline-block text-left">
<select class="appearance-none bg-surface-container-high text-on-surface pl-3 pr-8 py-2 rounded-lg font-code-sm text-code-sm focus:outline-none focus:ring-1 focus:ring-primary-container cursor-pointer shadow-sm">
<option selected="">Role: Software Engineering</option>
<option>Role: AI / ML Engineering</option>
<option>Role: Systems &amp; Cloud Infrastructure</option>
<option>Role: Security &amp; Cryptography</option>
<option>Role: Quantitative Developer</option>
</select>
<span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-on-surface-variant text-base pointer-events-none">expand_more</span>
</div>
<!-- Grad Year Dropdown -->
<div class="relative inline-block text-left">
<select class="appearance-none bg-surface-container-high text-on-surface pl-3 pr-8 py-2 rounded-lg font-code-sm text-code-sm focus:outline-none focus:ring-1 focus:ring-primary-container cursor-pointer shadow-sm">
<option selected="">Grad: 2026 / 2027</option>
<option>Grad: Fall 2025 (New Grad)</option>
<option>Grad: Undergrad (Any)</option>
<option>Grad: MS / PhD Specialized</option>
</select>
<span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-on-surface-variant text-base pointer-events-none">expand_more</span>
</div>
<!-- Work Auth Badge Toggle -->
<button class="inline-flex items-center gap-1.5 px-space-md py-2 rounded-lg bg-surface-container-high hover:bg-surface-variant text-secondary font-code-sm text-code-sm transition-colors shadow-sm whitespace-nowrap" type="button">
<span class="material-symbols-outlined text-sm">verified_user</span>
<span>US F1-OPT Friendly</span>
</button>
<!-- Sort Dropdown -->
<div class="relative inline-block text-left">
<select class="appearance-none bg-surface-container-high text-tertiary pl-3 pr-8 py-2 rounded-lg font-code-sm text-code-sm focus:outline-none focus:ring-1 focus:ring-primary-container cursor-pointer shadow-sm font-medium">
<option selected="">Sort: Deadline (Soonest)</option>
<option>Sort: Recently Opened</option>
<option>Sort: Company Tier (FAANG first)</option>
<option>Sort: Project Fit Match %</option>
</select>
<span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-tertiary text-base pointer-events-none">swap_vert</span>
</div>
</div>
</div>
<!-- Bottom Row: Company Quick-Pill Scroller -->
<div class="flex items-center gap-2 overflow-x-auto pb-1 text-on-surface">
<span class="font-label-caps text-label-caps text-outline uppercase tracking-wider whitespace-nowrap flex-shrink-0 mr-1">Quick Filter:</span>
<button class="px-space-md py-1 rounded-full bg-primary-container text-on-primary font-code-sm text-code-sm font-semibold shadow-[0_0_8px_rgba(128,131,255,0.4)] whitespace-nowrap" type="button">
            All Companies (142)
          </button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
            Google <span class="text-outline text-[10px]">12</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            Meta <span class="text-outline text-[10px]">8</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant"></span>
            Apple <span class="text-outline text-[10px]">5</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            Amazon <span class="text-outline text-[10px]">18</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-error"></span>
            Netflix <span class="text-outline text-[10px]">2</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            Microsoft <span class="text-outline text-[10px]">14</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
            Palantir <span class="text-outline text-[10px]">6</span>
</button>
<button class="px-space-md py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm whitespace-nowrap transition-colors flex items-center gap-1.5" type="button">
            Stripe <span class="text-outline text-[10px]">4</span>
</button>
</div>
